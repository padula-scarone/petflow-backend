# Base de datos (Prisma)
# DATABASE_URL: conexion que usa el servidor en ejecucion (pooler de Supabase)
DATABASE_URL=postgresql://usuario:clave@host-del-pooler:5432/postgres
# DIRECT_URL: conexion directa que usa la CLI de Prisma (tambien se necesita en el build)
DIRECT_URL=postgresql://usuario:clave@host-directo:5432/postgres

# Seguridad (login y JWT)
# Cadena larga y aleatoria; el servidor no arranca sin ella
JWT_SECRETO=cambiar-por-una-cadena-larga-y-aleatoria

# Claves de los usuarios semilla (las lee prisma/seed.ts)
SEED_CLAVE_VENDEDOR=clave-de-ejemplo
SEED_CLAVE_GESTOR_COMERCIAL=clave-de-ejemplo
SEED_CLAVE_GERENTE=clave-de-ejemplo

# CORS: origen del frontend permitido
CORS_ORIGEN_PERMITIDO=http://localhost:5173