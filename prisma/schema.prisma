// =====================================================================
// PetFlow - DEMO Módulo de Ventas (CUB 1.1, 1.2, 1.4 + Login 6.1)
// Nombres de modelos y campos en PascalCase/camelCase; nombres físicos
// en snake_case mediante @map y @@map.
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  VENDEDOR
  GESTOR_COMERCIAL
  GERENTE

  @@map("rol_usuario")
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO

  @@map("estado_registro")
}

enum EstadoCaja {
  ABIERTA
  CERRADA

  @@map("estado_caja")
}

enum FormatoVenta {
  UNIDAD
  GRANEL

  @@map("formato_venta")
}

enum TipoMedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  BILLETERA_VIRTUAL

  @@map("tipo_medio_pago")
}

enum OrigenVenta {
  MOSTRADOR
  DIGITAL

  @@map("origen_venta")
}

enum ModalidadEntrega {
  RETIRO
  ENVIO

  @@map("modalidad_entrega")
}

// COMPLETADA: tiene ticket de pago, pago registrado e impacto en caja
// PENDIENTE_PAGO: fiado, descontó stock y tiene detalles y ticket de deuda, sin pago ni impacto en caja
// ANULADA: baja lógica. Repone el stock; no reescribe pagos, idCaja ni saldo de caja (la venta deja de contar por su estado).
// Guarda quién, cuándo y por qué se anuló en fechaHoraAnulacion, idUsuarioAnulacion y motivoAnulacion
enum EstadoVenta {
  COMPLETADA
  PENDIENTE_PAGO
  ANULADA

  @@map("estado_venta")
}

enum EstadoCambio {
  ACTIVO
  ANULADO

  @@map("estado_cambio")
}

// 1. SEGURIDAD Y CAJA
model Usuario {
  idUsuario    Int            @id @default(autoincrement()) @map("id_usuario")
  username     String         @unique @db.VarChar(50)
  nombre       String         @db.VarChar(50)
  rol          RolUsuario
  passwordHash String         @map("password_hash") @db.VarChar(255)
  estado       EstadoRegistro @default(ACTIVO)

  sesionesCaja SesionCaja[]
  ventas       Venta[]
  ventasAnuladas Venta[] @relation("VentaUsuarioAnulacion")
  cambios      CambioMercaderia[]
  cambiosAnulados CambioMercaderia[] @relation("CambioUsuarioAnulacion")
  cobrosDeudor CobroDeudor[]

  @@map("usuarios")
}

model SesionCaja {
  idCaja        Int        @id @default(autoincrement()) @map("id_caja")
  idUsuario     Int        @map("id_usuario")
  fechaApertura DateTime   @default(now()) @map("fecha_apertura") @db.Timestamptz(6)
  fechaCierre   DateTime?  @map("fecha_cierre") @db.Timestamptz(6)
  saldoActual   Decimal    @default(0.00) @map("saldo_actual") @db.Decimal(12, 2)
  estado        EstadoCaja @default(ABIERTA)

  usuario  Usuario @relation(fields: [idUsuario], references: [idUsuario])
  ventas   Venta[]
  cambios  CambioMercaderia[]
  cobrosDeudor CobroDeudor[]

  @@map("sesiones_caja")
}

// 2. CATÁLOGO BASE
model Categoria {
  idCategoria Int                 @id @default(autoincrement()) @map("id_categoria")
  nombre      String              @db.VarChar(50)

  productos   Producto[]
  atributos   CategoriaAtributo[]

  @@map("categorias")
}

model CategoriaAtributo {
  idAtributo    Int       @id @default(autoincrement()) @map("id_atributo")
  idCategoria   Int       @map("id_categoria")
  clave         String    @db.VarChar(50)
  opciones      Json?     @db.JsonB
  nombreAtributo String   @map("nombre_atributo") @db.VarChar(50)
  tipoDato      String    @map("tipo_dato") @db.VarChar(20)
  esRequerido   Boolean   @default(false) @map("es_requerido")

  categoria Categoria @relation(fields: [idCategoria], references: [idCategoria])

  @@map("categoria_atributos")
}

model Producto {
  idProducto       Int            @id @default(autoincrement()) @map("id_producto")
  idCategoria      Int            @map("id_categoria")
  atributosExtra   String?        @map("atributos_extra")
  codigoBarras     String?        @unique @map("codigo_barras") @db.VarChar(50)
  nombre           String         @db.VarChar(100)
  formatoVenta     FormatoVenta   @map("formato_venta")
  costoActual      Decimal        @map("costo_actual") @db.Decimal(10, 2)
  precioVenta      Decimal        @map("precio_venta") @db.Decimal(10, 2)
  stockFisico      Decimal        @default(0.000) @map("stock_fisico") @db.Decimal(10, 3)
  // Producto GRANEL al que se suma el contenido de una bolsa abierta devuelta; solo lo tienen los productos UNIDAD
  idProductoGranel Int?           @map("id_producto_granel")
  // Kilos que pesa una unidad (una bolsa). Nulo si no aplica o no está cargado; sin peso no se admite bolsa abierta
  pesoUnitario     Decimal?       @map("peso_unitario") @db.Decimal(10, 3)
  estado           EstadoRegistro @default(ACTIVO)

  categoria             Categoria          @relation(fields: [idCategoria], references: [idCategoria])
  productoGranel        Producto?          @relation("ProductoGranel", fields: [idProductoGranel], references: [idProducto])
  productosFraccionados Producto[]         @relation("ProductoGranel")
  detallesVenta         DetalleVenta[]
  cambiosDevueltos      CambioMercaderia[] @relation("CambioProductoDevuelto")
  cambiosStockIngresado CambioMercaderia[] @relation("CambioProductoStockIngresado")
  cambiosEntregados     CambioMercaderia[] @relation("CambioProductoEntregado")

  @@map("productos")
}

model MedioPago {
  idMedioPago       Int            @id @default(autoincrement()) @map("id_medio_pago")
  nombre            String         @db.VarChar(50)
  tipo              TipoMedioPago
  porcentajeRecargo Decimal        @default(0.00) @map("porcentaje_recargo") @db.Decimal(5, 2)
  porcentajeDescuento Decimal      @default(0.00) @map("porcentaje_descuento") @db.Decimal(5, 2)
  estado            EstadoRegistro @default(ACTIVO)

  pagos    PagoVenta[]
  cambios  CambioMercaderia[]
  pagosCobroDeudor PagoCobroDeudor[]

  @@map("medios_pago")
}

// 3. NÚCLEO TRANSACCIONAL DE VENTAS
model Venta {
  idVenta           Int              @id @default(autoincrement()) @map("id_venta")
  // Nullable por decisión de diseño, pero toda venta nueva (cobrada o fiado) lo recibe al instante
  numeroComprobante String?          @unique @map("numero_comprobante") @db.VarChar(30)
  fechaHora         DateTime         @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  // Nulo si es fiado; se completa al cobrar
  fechaHoraPago     DateTime?        @map("fecha_hora_pago") @db.Timestamptz(6)
  origen            OrigenVenta
  modalidadEntrega  ModalidadEntrega @map("modalidad_entrega")
  // Direccion a la que se envia el pedido. Obligatoria (a nivel de aplicacion) solo con modalidadEntrega ENVIO; nula en RETIRO
  // y en las ventas anteriores. Es un dato personal: no va al historial, ni a mensajes de error, ni a logs (RNF-VENTAS-03)
  direccionEnvio    String?          @map("direccion_envio") @db.VarChar(200)
  // Obsoleto: texto libre de las ventas anteriores al vinculo con deudores. Ya no se escribe; se conserva solo para leerlo
  clienteReferencia String?          @map("cliente_referencia") @db.VarChar(100)
  // Deudor del fiado. Nulo en las ventas de contado y en las anteriores al vinculo (obligatorio solo en el alta de un fiado, lo valida el esquema)
  idDeudor          Int?             @map("id_deudor")
  // Fecha (sin hora) en que el deudor prometio pagar el fiado. Solo informativa: no bloquea ni modifica cobros, saldo ni estados.
  // Nula en contado y en fiados sin fecha. Columna date: se escribe y se lee como medianoche UTC para que no corra un dia
  fechaEstimadaPago DateTime?        @map("fecha_estimada_pago") @db.Date
  subtotalBruto    Decimal          @map("subtotal_bruto") @db.Decimal(12, 2)
  descuentoManual   Decimal          @default(0.00) @map("descuento_manual") @db.Decimal(10, 2)
  // Obligatorio (a nivel de aplicacion) cuando hay descuento manual; nulo en ventas sin descuento o anteriores
  motivoDescuento   String?          @map("motivo_descuento") @db.VarChar(200)
  montoTotal       Decimal          @map("monto_total") @db.Decimal(12, 2)
  estado            EstadoVenta      @default(COMPLETADA)
  idUsuario         Int              @map("id_usuario")
  // Nulo mientras el fiado no se cobra
  idCaja            Int?             @map("id_caja")
  // Auditoría de la anulación: nulos mientras la venta no está ANULADA y en anulaciones anteriores a este registro
  fechaHoraAnulacion DateTime?       @map("fecha_hora_anulacion") @db.Timestamptz(6)
  idUsuarioAnulacion Int?            @map("id_usuario_anulacion")
  motivoAnulacion    String?         @map("motivo_anulacion") @db.VarChar(200)

  usuario  Usuario      @relation(fields: [idUsuario], references: [idUsuario])
  // Quien anuló (puede ser distinto del vendedor); relación con nombre propio porque Venta ya apunta a Usuario por `usuario`
  usuarioAnulacion Usuario? @relation("VentaUsuarioAnulacion", fields: [idUsuarioAnulacion], references: [idUsuario])
  caja     SesionCaja?  @relation(fields: [idCaja], references: [idCaja])
  // Replica la FK ya aplicada a mano en la base (ON DELETE RESTRICT, ON UPDATE CASCADE): un deudor con ventas no se puede borrar
  deudor   Deudor?      @relation(fields: [idDeudor], references: [idDeudor], onDelete: Restrict, onUpdate: Cascade, map: "ventas_id_deudor_fkey")
  pagos    PagoVenta[]
  detalles DetalleVenta[]
  cambiosOriginados CambioMercaderia[]
  detallesCobroDeudor DetalleCobroDeudor[]

  @@index([fechaHora])
  @@index([estado])
  @@index([idCaja])
  @@index([clienteReferencia])
  @@index([idDeudor], map: "ventas_id_deudor_idx")
  @@map("ventas")
}

// Vacía mientras la venta está en PENDIENTE_PAGO
model PagoVenta {
  idPagoVenta         Int      @id @default(autoincrement()) @map("id_pago_venta")
  idVenta             Int      @map("id_venta")
  idMedioPago         Int      @map("id_medio_pago")
  montoBase           Decimal  @map("monto_base") @db.Decimal(12, 2)
  porcentajeAplicado  Decimal  @default(0.00) @map("porcentaje_aplicado") @db.Decimal(5, 2)
  montoFinal          Decimal  @map("monto_final") @db.Decimal(12, 2)
  montoRecibido       Decimal? @map("monto_recibido") @db.Decimal(12, 2)
  vuelto              Decimal? @db.Decimal(12, 2)

  venta      Venta     @relation(fields: [idVenta], references: [idVenta])
  medioPago  MedioPago @relation(fields: [idMedioPago], references: [idMedioPago])

  @@unique([idVenta, idMedioPago])
  @@map("pagos_venta")
}

// Siempre guarda los productos que salieron del local (cobrados o fiados)
model DetalleVenta {
  idDetalle              Int     @id @default(autoincrement()) @map("id_detalle")
  idVenta                Int     @map("id_venta")
  idProducto             Int     @map("id_producto")
  cantidad               Decimal @db.Decimal(10, 3)
  precioUnitarioVigente  Decimal @map("precio_unitario_vigente") @db.Decimal(10, 2)
  costoUnitarioCongelado Decimal @map("costo_unitario_congelado") @db.Decimal(10, 2)
  subtotal               Decimal @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [idVenta], references: [idVenta])
  producto Producto @relation(fields: [idProducto], references: [idProducto])

  @@index([idVenta])
  @@index([idProducto])
  @@map("detalles_venta")
}

// 4. CAMBIOS DE MERCADERÍA
model CambioMercaderia {
  idCambio                        Int          @id @default(autoincrement()) @map("id_cambio")
  fechaHora                       DateTime     @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  idVentaOriginal                 Int?         @map("id_venta_original")
  idUsuario                       Int          @map("id_usuario")
  idCaja                          Int          @map("id_caja")

  // Artículo que entra (devuelto por el cliente)
  idProductoDevuelto              Int          @map("id_producto_devuelto")
  // Unidades devueltas (enteras si el producto es UNIDAD)
  cantidadDevuelta                Decimal      @map("cantidad_devuelta") @db.Decimal(10, 3)
  // Bolsa abierta: el contenido se suma al granel del producto devuelto en vez de reponer la unidad
  esBolsaAbierta                  Boolean      @default(false) @map("es_bolsa_abierta")
  precioUnitarioDevuelto          Decimal      @map("precio_unitario_devuelto") @db.Decimal(10, 2)
  // Producto cuyo stock recibe el ingreso: el mismo devuelto, o su granel si es bolsa abierta
  idProductoStockIngresado        Int          @map("id_producto_stock_ingresado")
  // Lo que entró al stock: unidades del producto ingresado, o kilos si ingresó a granel (bolsa abierta).
  // Se guarda para revertir con exactitud aunque después cambie el peso del producto
  cantidadStockIngresado          Decimal      @map("cantidad_stock_ingresado") @db.Decimal(10, 3)

  // Artículo que sale (entregado al cliente)
  idProductoEntregado             Int          @map("id_producto_entregado")
  cantidadEntregada               Decimal      @map("cantidad_entregada") @db.Decimal(10, 3)
  precioUnitarioEntregado         Decimal      @map("precio_unitario_entregado") @db.Decimal(10, 2)
  costoUnitarioCongeladoEntregado Decimal      @map("costo_unitario_congelado_entregado") @db.Decimal(10, 2)

  // Diferencia económica (>= 0, sin reembolso)
  saldoResultante                 Decimal      @default(0.00) @map("saldo_resultante") @db.Decimal(10, 2)
  idMedioPago                     Int?         @map("id_medio_pago")
  estado                          EstadoCambio @default(ACTIVO)

  // Texto que arma el front a partir del motivo elegido; nulo en cambios anteriores a este registro
  motivoCambio                    String?      @map("motivo_cambio") @db.VarChar(200)
  // Cobro del saldo en efectivo: nulos si no hubo saldo, si el medio no es efectivo o si no se informo el recibido
  montoRecibido                   Decimal?     @map("monto_recibido") @db.Decimal(12, 2)
  vuelto                          Decimal?     @db.Decimal(12, 2)
  // Auditoria de la anulacion: nulos mientras el cambio no esta ANULADO
  fechaHoraAnulacion              DateTime?    @map("fecha_hora_anulacion") @db.Timestamptz(6)
  idUsuarioAnulacion              Int?         @map("id_usuario_anulacion")
  motivoAnulacion                 String?      @map("motivo_anulacion") @db.VarChar(200)

  ventaOriginal     Venta?      @relation(fields: [idVentaOriginal], references: [idVenta])
  usuario           Usuario     @relation(fields: [idUsuario], references: [idUsuario])
  // Quien anulo el cambio (puede ser distinto del vendedor). Replica el nombre de FK que ya existe en la base
  usuarioAnulacion  Usuario?    @relation("CambioUsuarioAnulacion", fields: [idUsuarioAnulacion], references: [idUsuario], onDelete: SetNull, onUpdate: Cascade, map: "cambios_mercaderia_id_usuario_anulacion_fkey")
  caja              SesionCaja  @relation(fields: [idCaja], references: [idCaja])
  productoDevuelto  Producto    @relation("CambioProductoDevuelto", fields: [idProductoDevuelto], references: [idProducto])
  productoStockIngresado Producto @relation("CambioProductoStockIngresado", fields: [idProductoStockIngresado], references: [idProducto])
  productoEntregado Producto    @relation("CambioProductoEntregado", fields: [idProductoEntregado], references: [idProducto])
  medioPago         MedioPago?  @relation(fields: [idMedioPago], references: [idMedioPago])

  @@index([fechaHora])
  @@index([idVentaOriginal])
  @@map("cambios_mercaderia")
}

// 5. DEUDORES
// Persona que tiene o tuvo un fiado. Se identifica por su DNI (unico). No hay baja: no tiene estado.
// La tabla se crea a mano en Supabase; Prisma solo la mapea.
model Deudor {
  idDeudor       Int    @id @default(autoincrement()) @map("id_deudor")
  nombreCompleto String @map("nombre_completo") @db.VarChar(100)
  // Solo digitos, de 11 a 15, con codigo de pais
  telefono       String @db.VarChar(15)
  // Solo digitos, 7 u 8, sin puntos; texto para conservar ceros a la izquierda
  dni            String @unique @db.VarChar(8)

  ventas         Venta[]
  cobros         CobroDeudor[]

  @@map("deudores")
}

// 6. COBROS DE DEUDORES
// Las tres tablas se crean a mano en Supabase (con RLS activo); Prisma solo las mapea.
// Los nombres de FK, unicos e indices son los de PostgreSQL por defecto (`<tabla>_<columna>_fkey`, `_key`, `_idx`, `_pkey`).
// Un cobro de deudor es un pago aplicado a uno o varios fiados del mismo deudor. Guarda la caja y el usuario del cobro,
// que el fiado no tiene (el fiado conserva `idCaja` nulo).

// Un cobro: quien paga (deudor), en que caja, quien lo registro y cuando
model CobroDeudor {
  idCobroDeudor Int      @id @default(autoincrement()) @map("id_cobro_deudor")
  idDeudor      Int      @map("id_deudor")
  idCaja        Int      @map("id_caja")
  idUsuario     Int      @map("id_usuario")
  fechaHora     DateTime @default(now()) @map("fecha_hora") @db.Timestamptz(6)
  // Nulo hasta que se asigna el recibo (como el comprobante de las ventas)
  numeroRecibo  String?  @unique(map: "cobros_deudor_numero_recibo_key") @map("numero_recibo") @db.VarChar(30)

  deudor   Deudor      @relation(fields: [idDeudor], references: [idDeudor], onDelete: Restrict, onUpdate: Cascade, map: "cobros_deudor_id_deudor_fkey")
  caja     SesionCaja  @relation(fields: [idCaja], references: [idCaja], onDelete: Restrict, onUpdate: Cascade, map: "cobros_deudor_id_caja_fkey")
  usuario  Usuario     @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, onUpdate: Cascade, map: "cobros_deudor_id_usuario_fkey")
  detalles DetalleCobroDeudor[]
  pagos    PagoCobroDeudor[]

  @@index([idDeudor], map: "cobros_deudor_id_deudor_idx")
  @@index([idCaja], map: "cobros_deudor_id_caja_idx")
  @@map("cobros_deudor")
}

// Cuanto de un cobro se aplico a cada fiado. La base exige monto > 0 (CHECK); Prisma no puede expresarlo.
// `yaPagado` de un fiado es la suma de estos montos
model DetalleCobroDeudor {
  idDetalleCobroDeudor Int     @id @default(autoincrement()) @map("id_detalle_cobro_deudor")
  idCobroDeudor        Int     @map("id_cobro_deudor")
  idVenta              Int     @map("id_venta")
  monto                Decimal @db.Decimal(12, 2)

  cobro CobroDeudor @relation(fields: [idCobroDeudor], references: [idCobroDeudor], onDelete: Restrict, onUpdate: Cascade, map: "detalles_cobro_deudor_id_cobro_deudor_fkey")
  venta Venta       @relation(fields: [idVenta], references: [idVenta], onDelete: Restrict, onUpdate: Cascade, map: "detalles_cobro_deudor_id_venta_fkey")

  @@unique([idCobroDeudor, idVenta], map: "detalles_cobro_deudor_id_cobro_deudor_id_venta_key")
  @@index([idVenta], map: "detalles_cobro_deudor_id_venta_idx")
  @@map("detalles_cobro_deudor")
}

// Como se pago un cobro: un medio por fila. La base exige montoBase y montoFinal > 0 (CHECK).
// Mismas columnas que `pagos_venta`: el recargo o descuento del medio queda congelado en `porcentajeAplicado`
model PagoCobroDeudor {
  idPagoCobroDeudor  Int      @id @default(autoincrement()) @map("id_pago_cobro_deudor")
  idCobroDeudor      Int      @map("id_cobro_deudor")
  idMedioPago        Int      @map("id_medio_pago")
  montoBase          Decimal  @map("monto_base") @db.Decimal(12, 2)
  porcentajeAplicado Decimal  @default(0.00) @map("porcentaje_aplicado") @db.Decimal(5, 2)
  montoFinal         Decimal  @map("monto_final") @db.Decimal(12, 2)
  montoRecibido      Decimal? @map("monto_recibido") @db.Decimal(12, 2)
  vuelto             Decimal? @db.Decimal(12, 2)

  cobro     CobroDeudor @relation(fields: [idCobroDeudor], references: [idCobroDeudor], onDelete: Restrict, onUpdate: Cascade, map: "pagos_cobro_deudor_id_cobro_deudor_fkey")
  medioPago MedioPago   @relation(fields: [idMedioPago], references: [idMedioPago], onDelete: Restrict, onUpdate: Cascade, map: "pagos_cobro_deudor_id_medio_pago_fkey")

  @@unique([idCobroDeudor, idMedioPago], map: "pagos_cobro_deudor_id_cobro_deudor_id_medio_pago_key")
  @@map("pagos_cobro_deudor")
}
